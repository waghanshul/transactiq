# Copy to .env.local for local development. On Vercel, set these in
# Project Settings > Environment Variables (the Neon integration sets DATABASE_URL).

# Neon Postgres connection string (pooled or direct). A local Postgres URL also works.
DATABASE_URL=postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Protects POST /api/reset. Use a long random string, e.g. `openssl rand -hex 24`.
RESET_SECRET=

# Optional: signs demo sign-in sessions. Falls back to RESET_SECRET if unset.
AUTH_SECRET=

# Optional: Google AI Studio key for the Gemini fallback (free tier). Only free-text
# address lines are sent, never names, accounts or amounts. Without it the rules
# still work and unsure addresses show options instead of a guess.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest

# Below this confidence the repair panel shows options, never a guess (0 to 1).
# SUGGESTION_MIN_CONFIDENCE=0.7
# The address engine asks Gemini only below this confidence.
# SUGGESTION_LLM_BELOW=0.8

# Identifies this app to OpenStreetMap Nominatim, per its usage policy.
NOMINATIM_UA="transactiq-poc/0.3 (https://github.com/waghanshul/transactiq)"
# NOMINATIM_DISABLED=1

# Sprint 4: Resend key for sending the drafted client note to your own inbox.
RESEND_API_KEY=
